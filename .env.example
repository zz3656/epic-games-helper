# ============================================
# Epic Games 自动领取 - 环境变量配置模板
# ============================================
# 容器首次启动时会自动生成 EPIC_MASTER_KEY，
# 也可手动创建 .env 文件并自定义配置

# ---------- 主密钥 (必填) ----------
# 用于加密保存的账号密码（Fernet / AES-128-CBC + HMAC）
# 留空则首次运行时自动生成
EPIC_MASTER_KEY=

# ---------- 调度配置 (可选) ----------
# Epic Games 免费游戏在 北京时间每周五 0:00 更新
# 默认周五 0:05 检查（避开高峰期）
TZ=Asia/Shanghai
SCHEDULE_DAY=fri
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=5

# ---------- 运行配置 (可选) ----------
HEADLESS=true
LOG_LEVEL=INFO

# ---------- 自动领取开关 (可选) ----------
# true=容器启动时自动开启自动领取（需凭证已配置）
AUTO_CLAIM_ENABLED=false

# ---------- Webhook 推送通知 (可选) ----------
# 定时检查到本周免费游戏有变化时，发送推送通知
# 需要填3个环境变量才能启用，未配置时定时任务仅记录历史不推送

# 推送类型：bark | serverchan | telegram | generic
# NOTIFY_WEBHOOK_TYPE=bark

# Bark 示例（iOS 推送）：
# NOTIFY_WEBHOOK_URL=https://api.day.app
# NOTIFY_WEBHOOK_TOKEN=你的_device_key

# Server 酱示例（微信推送）：
# NOTIFY_WEBHOOK_TYPE=serverchan
# NOTIFY_WEBHOOK_URL=https://sctapi.ftqq.com
# NOTIFY_WEBHOOK_TOKEN=你的_sendkey

# Telegram Bot 示例：
# NOTIFY_WEBHOOK_TYPE=telegram
# NOTIFY_WEBHOOK_URL=https://api.telegram.org/-你的chat_id
# NOTIFY_WEBHOOK_TOKEN=你的_bot_token

# 通用 Webhook 示例（POST JSON 到你的 URL）：
# NOTIFY_WEBHOOK_TYPE=generic
# NOTIFY_WEBHOOK_URL=https://your-webhook.example.com/epic-notify
