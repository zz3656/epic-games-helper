# ============================================
# Epic Games 自动领取 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# .env 已加入 .gitignore，不会被提交

# ---------- 主密钥 (必填) ----------
# 用于加密保存的账号密码（Fernet / AES-128-CBC + HMAC）
# 生成方式：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 泄露此 key = 已保存凭证泄露，请妥善保管
EPIC_MASTER_KEY=FJIZ4EESnuMh0vdPG1k1Lgbkl50LuSFhO24g6vbuTHo=

# ---------- 调度配置 (可选) ----------
TZ=Asia/Shanghai
SCHEDULE_DAY=thu
SCHEDULE_HOUR=17
SCHEDULE_MINUTE=0

# ---------- 运行配置 (可选) ----------
HEADLESS=true
LOG_LEVEL=INFO

# ---------- 自动领取开关 (可选) ----------
# true=容器启动时自动开启自动领取（需凭证已配置）
AUTO_CLAIM_ENABLED=true