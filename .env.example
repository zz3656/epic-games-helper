# ============================================
# Epic Games Free Games Helper - 环境变量配置模板
# ============================================
# 容器首次启动时会自动生成相关密钥，
# 也可手动创建 .env 文件并自定义配置

# ---------- 调度配置 (可选) ----------
# Epic Games 免费游戏在 北京时间每周五 0:00 更新
# 默认周五 0:05 检查（避开高峰期）
TZ=Asia/Shanghai
SCHEDULE_DAY=fri
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=5

# ---------- 运行配置 (可选) ----------
HEADLESS=true
LOG_LEVEL=INFO

# ---------- 认证配置 (可选) ----------
# JWT 签名密钥，用于用户登录认证
# 留空则首次运行时自动生成（重启后旧 token 失效）
# 建议在生产环境中手动设置一个固定值
# AUTH_SECRET_KEY=your-random-secret-key-here

# Token 过期时间（小时），默认 24
# AUTH_TOKEN_EXPIRE_HOURS=24

# ---------- 全局 Webhook 推送通知 (可选) ----------
# 定时检查到本周免费游戏有变化时，发送全局推送通知
# 需要同时配置 TYPE + TOKEN 才能启用
# 未配置时定时任务仅记录历史，不推送

# 推送类型：bark | serverchan | pushplus | telegram | generic
# NOTIFY_WEBHOOK_TYPE=bark

# Bark 示例（iOS 推送）：
# NOTIFY_WEBHOOK_TYPE=bark
# NOTIFY_WEBHOOK_TOKEN=你的_device_key

# Server 酱示例（微信推送）：
# NOTIFY_WEBHOOK_TYPE=serverchan
# NOTIFY_WEBHOOK_TOKEN=你的_sendkey

# PushPlus 示例（微信/钉钉/飞书/邮件，推荐）：
# NOTIFY_WEBHOOK_TYPE=pushplus
# NOTIFY_WEBHOOK_TOKEN=你的_token
# PUSHPLUS_CHANNEL=wechat  # wechat/webhook/email/sms/bark/voice

# Telegram Bot 示例：
# NOTIFY_WEBHOOK_TYPE=telegram
# NOTIFY_WEBHOOK_URL=https://api.telegram.org/bot{你的bot_token}/sendMessage
# NOTIFY_WEBHOOK_TOKEN={你的chat_id}

# 通用 Webhook 示例（POST JSON 到你的 URL）：
# NOTIFY_WEBHOOK_TYPE=generic
# NOTIFY_WEBHOOK_URL=https://your-webhook.example.com/epic-notify

# ---------- 说明 ----------
# 全局推送是**系统级**的，所有人都收到同一份通知
# 每个已登录用户可以在 Web UI 的「推送设置」中配置**自己的**推送渠道
# 定时任务触发时，全局推送 + 所有已启用推送的用户推送 都会被发送
