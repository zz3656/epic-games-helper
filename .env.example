# ============================================
# Epic Games 自动领取 - 环境变量配置模板
# ============================================
# 容器首次启动时会自动生成 EPIC_MASTER_KEY，
# 也可手动创建 .env 文件并自定义配置

# ---------- 主密钥 (必填) ----------
# 用于加密保存的账号密码（Fernet / AES-128-CBC + HMAC）
# 留空则首次运行时自动生成
EPIC_MASTER_KEY=

# ---------- 调度配置 (可选) ----------
TZ=Asia/Shanghai
SCHEDULE_DAY=thu
SCHEDULE_HOUR=17
SCHEDULE_MINUTE=0

# ---------- 运行配置 (可选) ----------
HEADLESS=true
LOG_LEVEL=INFO

# ---------- 自动领取开关 (可选) ----------
# true=容器启动时自动开启自动领取（需凭证已配置）
AUTO_CLAIM_ENABLED=false
